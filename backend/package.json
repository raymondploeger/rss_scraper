{
  "name": "rss-monitoring-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate deploy",
    "dev": "node --watch src/server.js",
    "start": "node src/start.js",
    "db:size": "node scripts/database-size-report.js",
    "db:poll-logs": "node scripts/poll-logs-analysis.js",
    "db:poll-indexes": "node scripts/poll-logs-index-analysis.js",
    "db:cleanup-poll-logs": "node scripts/cleanup-poll-logs.js",
    "db:product-cleanup": "node scripts/cleanup-product-pages.js",
    "db:product-cleanup:execute": "node scripts/cleanup-product-pages.js --execute",
    "db:optimize-poll-indexes": "node scripts/optimize-poll-log-indexes.js",
    "digital-subgroup:diagnostics": "node scripts/digital-subgroup-overlap-diagnostics.js",
    "image:compare-google-news": "node scripts/image-compare-google-news.js",
    "image:diagnostics": "node scripts/image-diagnostics.js",
    "google-news:inspect-raw-rss": "node scripts/google-news-raw-rss-inspect.js",
    "google-news:inspect-ingest-fields": "node scripts/google-news-inspect-ingest-fields.js",
    "google-news:trace-source-url": "node scripts/google-news-trace-source-url.js",
    "google-news-diagnostics": "node scripts/google-news-diagnostics.js",
    "google-news:analyze-url": "node scripts/google-news-analyze-url.js",
    "google-news:thumbnail-backfill": "node scripts/google-news-thumbnail-backfill.js",
    "google-news:thumbnail-backfill:execute": "node scripts/google-news-thumbnail-backfill.js --execute",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "prisma": "^6.8.2",
    "rss-parser": "^3.13.0"
  }
