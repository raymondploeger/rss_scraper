{
  "name": "rss-monitoring-dashboard-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions,hosting,firestore --project demo-rss-monitor --import=../.firebase/demo-rss-monitor --export-on-exit=../.firebase/demo-rss-monitor",
    "seed:emulator": "node scripts/seed-emulator.js",
    "deploy": "firebase deploy --only functions,hosting,firestore",
    "lint": "eslint --ext .js,.ts ."
  },
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1",
    "helmet": "^8.1.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.30",
    "typescript": "^5.8.3"
  }
}
