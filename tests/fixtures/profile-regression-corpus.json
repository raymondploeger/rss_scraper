    {
      "id": "secunet-ees-czech-border-police",
      "article": {
        "title": "Czech Border Police: secunet technology significantly speeds up processes after EES introduction",
        "contentSnippet": "The Entry/Exit System supports border checks, travel-document inspection and traveller processing.",
        "topic": "Digital Identity & Biometrics",
        "source": "secunet.com",
        "feedName": "secunet Press"
      },
      "expected": {
        "domainsInclude": ["identity_documents"],
        "classificationsInclude": ["border_control"],
        "profileSignalsInclude": ["border_control"],
        "profileSignalsExclude": ["central_bank", "security_printer"],
        "profilePolicy": { "border_control": true, "central_bank": false }
      }
    },
