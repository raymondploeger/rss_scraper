        "topic": "Digital Identity & Biometrics",
        "source": "secunet.com",
        "feedName": "secunet Press"
      },
      "expected": {
        "domainsInclude": ["identity_documents"],
        "classificationsInclude": ["border_control"],
        "profileSignalsInclude": ["border_control", "vendors", "researcher"],
        "profileSignalsExclude": ["central_bank", "security_printer"],
        "profilePolicy": { "border_control": true, "central_bank": false }
      }
    },
